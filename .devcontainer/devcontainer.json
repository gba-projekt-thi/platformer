{
	"name": "GBA Development",
	"build": {
		"dockerfile": "../docker/Dockerfile",
		"context": ".."
	},
	// Set environment variables
	"containerEnv": {
		"DEVKITPRO": "/opt/devkitpro",
		"DEVKITARM": "/opt/devkitpro/devkitARM",
		"BUTANO_HOME": "/workspace/extern/engine/extern/butano"
	},
	// Configure VS Code settings
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			},
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"ms-vscode.cmake-tools",
				"twxs.cmake",
				"eamodio.gitlens",
				"ms-python.python",
				"Continue.continue"
			]
		}
	},
	"postCreateCommand": "${containerWorkspaceFolder}/post-create.sh",
	"updateContentCommand": "${containerWorkspaceFolder}/post-create.sh",
	// NOTE: No manual X11 mount, no "xhost", no "--privileged" needed here.
	// The Dev Containers extension (Remote-WSL + WSLg) forwards X11/DISPLAY
	// to the container automatically. A manual bind mount of /tmp/.X11-unix
	// conflicts with that built-in forwarding (it shadows the read-only
	// WSLg socket dir and blocks the extension's own socket setup, causing
	// "listen EROFS: read-only file system /tmp/.X11-unix/X1").
	"remoteEnv": {
		"SDL_AUDIODRIVER": "dummy"
	},
	// Set the default user
	"remoteUser": "ubuntu",
	"updateRemoteUserUID": true,
	// Mount the workspace folder
	"workspaceFolder": "/workspace",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind"
}