Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*

ExtraArgsBefore:
  - "-std=c++23"
  - "--target=arm-none-eabi"
  - "--sysroot=/opt/devkitpro/devkitARM/arm-none-eabi"
  - "-stdlib=libstdc++"
  - "-mthumb"
  - "-mcpu=arm7tdmi"
  - "-mtune=arm7tdmi"
  - "-Wno-unknown-argument"
  - "-Wno-unused-command-line-argument"
  - "-Wno-unqualified-std-cast-call"
  - "-isystem"
  - "/opt/devkitpro/devkitARM/arm-none-eabi/include/c++/current"
  - "-isystem"
  - "/opt/devkitpro/devkitARM/arm-none-eabi/include/c++/current/arm-none-eabi"
  - "-isystem"
  - "/opt/devkitpro/devkitARM/arm-none-eabi/include"
